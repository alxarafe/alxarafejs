# Environment Configuration
NODE_ENV="development" # Options: 'development', 'production', 'test'
PORT="8080"            # The port your server will listen on
HOST="localhost"       # Hostname for the server

# CORS Settings
CORS_ORIGIN="http://localhost:8080" # Allowed CORS origin, adjust as necessary

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="1000"  # Window size for rate limiting (ms)
COMMON_RATE_LIMIT_MAX_REQUESTS="20" # Max number of requests per window per IP

# Database (Prisma 7 requires a driver adapter; the URL is read by prisma.config.ts)
DATABASE_URL="postgresql://alxarafe:alxarafe@localhost:5433/alxarafejs?schema=public"

# Sessions (Redis-backed)
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="dev-only-secret-change-in-production-please" # MUST be at least 32 chars in production (no default)
SESSION_NAME="sid"
SESSION_TTL_SECONDS="604800" # 7 days

# Email (SMTP_TRANSPORT=disk forces the file transport; in production SMTP_HOST
# is required unless SMTP_TRANSPORT="disk" is set explicitly - never silent)
SMTP_TRANSPORT="smtp"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@alxarafe.com"

# Public base URL used to build email links (independent of the bind HOST/PORT;
# required in production)
PUBLIC_WEB_URL="http://localhost:8080"

# Proxy trust policy for Express, required (explicit) in production:
# "false" | "true" | number of hops | "loopback" | IP/subnet
TRUST_PROXY="false"

# Modules (optional runtime overrides; precedence: env > config/modules.json > module.json)
# Comma/space separated lists of module (or package) names.
# ALXARAFE_MODULES_ENABLED=""
# ALXARAFE_MODULES_DISABLED=""