# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# Generated Prisma client
packages/database/src/generated/

# Feature module artifacts — created LOCALLY by `alxarafe module add/remove`
# (fragment symlink + migrations). Modules are optional and may be written by
# third parties: they NEVER write into the core repo nor leave any trace in it.
packages/database/prisma/models/*
packages/database/prisma/migrations/*_drop_*_schema/

# Feature modules: always materialized locally (clone/copy), never tracked.
# They must not appear in the core repository at any time.
modules/*

# Module activation state — per-developer (created by `module add`/`enable`).
config/modules.json

# Development email files
emails/*
!emails/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Trabajo temporal de agentes
.agent-tmp/