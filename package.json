{
	"name": "alxarafejs",
	"version": "0.1.0",
	"description": "Alxarafe JS monorepo: Express backend modular",
	"author": "Rafael San José <rsanjose@alxarafe.com>",
	"repository": "https://github.com/alxarafe/alxarafejs",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=23.0.0"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"start:dev": "tsx watch --ignore '**/node_modules/**' apps/api/src/index.ts",
		"start:prod": "node apps/api/dist/index.js",
		"check": "biome check --write",
		"test": "vitest run --passWithNoTests",
		"test:cov": "vitest run --coverage",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"postinstall": "prisma generate"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@prisma/engines",
			"@scarf/scarf",
			"esbuild",
			"prisma"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@types/node": "^22.0.0",
		"@types/supertest": "6.0.3",
		"@vitest/coverage-v8": "3.2.4",
		"prisma": "^7.10.0",
		"supertest": "7.1.4",
		"tsx": "4.21.0",
		"typescript": "5.9.2",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.4"
	}
}
