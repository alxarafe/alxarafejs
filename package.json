{
	"name": "alxarafejs",
	"version": "0.1.0",
	"description": "Alxarafe JS monorepo: Express backend modular",
	"author": "Rafael San Jos\u00e9 <rsanjose@alxarafe.com>",
	"repository": "https://github.com/alxarafe/alxarafejs",
	"license": "MIT",
	"private": true,
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
	"engines": {
		"node": ">=23.0.0"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"start:dev": "tsx watch --ignore '**/node_modules/**' apps/api/src/index.ts",
		"start:prod": "node apps/api/dist/index.js",
		"check": "biome check --write",
		"test": "vitest run --passWithNoTests",
		"test:cov": "vitest run --coverage",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"postinstall": "prisma generate",
		"test:bruno": "bash scripts/bruno-api.sh"
	},
	"devDependencies": {
		"@alxarafe/cli": "workspace:*",
		"@biomejs/biome": "2.4.9",
		"@types/node": "^22.0.0",
		"@types/supertest": "6.0.3",
		"@usebruno/cli": "^4.1.0",
		"@vitest/coverage-v8": "3.2.4",
		"dotenv": "17.3.1",
		"prisma": "^7.10.0",
		"supertest": "7.1.4",
		"tsx": "4.21.0",
		"typescript": "5.9.2",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.4"
	}
}
