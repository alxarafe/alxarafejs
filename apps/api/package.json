{
	"name": "@alxarafe/api",
	"version": "0.1.0",
	"description": "Alxarafe JS API: application that mounts all modules and bootstraps the server",
	"private": true,
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b"
	},
	"dependencies": {
		"@alxarafe/auth": "workspace:*",
		"@alxarafe/contacts": "workspace:*",
		"@alxarafe/core": "workspace:*",
		"@alxarafe/database": "workspace:*",
		"@alxarafe/email": "workspace:*",
		"@alxarafe/session": "workspace:*",
		"@alxarafe/users": "workspace:*",
		"@asteasolutions/zod-to-openapi": "7.3.4",
		"cors": "2.8.6",
		"express": "5.2.1",
		"helmet": "8.1.0",
		"http-status-codes": "2.3.0",
		"swagger-ui-express": "5.0.1",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@types/cors": "2.8.19",
		"@types/express": "5.0.3",
		"@types/express-session": "^1.19.0",
		"@types/node": "^22.0.0",
		"@types/supertest": "6.0.3",
		"@types/swagger-ui-express": "4.1.8",
		"supertest": "7.1.4",
		"vitest": "3.2.4"
	}
}
