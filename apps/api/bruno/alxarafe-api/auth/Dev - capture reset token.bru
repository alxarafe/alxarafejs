meta {
  name: Dev: capture reset token
  type: http
  seq: 41
}

get {
  url: {{BASE_URL}}/auth/dev/email-tokens?email={{NEW_EMAIL}}&purpose=reset
  body: none
  auth: none
}

script:post-response {
  if (res.body && res.body.responseObject) {
    bru.setVar("resetToken", res.body.responseObject.token);
  }
}