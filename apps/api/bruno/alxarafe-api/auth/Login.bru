meta {
  name: Login
  type: http
  seq: 20
}

post {
  url: http://{{BASE_URL}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{EMAIL}}",
    "password": "{{PASSWORD}}"
  }
}

script:post-response {
  if (res.body && res.body.responseObject) {
    bru.setVar("csrfToken", res.body.responseObject.csrfToken);
    if (res.body.responseObject.user) {
      bru.setVar("userId", res.body.responseObject.user.id);
    }
  }
}