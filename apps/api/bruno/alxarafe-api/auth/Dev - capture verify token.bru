meta {
  name: Dev: capture verify token
  type: http
  seq: 33
}

get {
  url: {{BASE_URL}}/auth/dev/email-tokens?email={{NEW_EMAIL}}&purpose=verify
  body: none
  auth: none
}

script:post-response {
  if (res.body && res.body.responseObject) {
    bru.setVar("verifyToken", res.body.responseObject.token);
  }
}