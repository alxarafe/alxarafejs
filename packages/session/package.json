{
	"name": "@alxarafe/session",
	"version": "0.1.0",
	"description": "Alxarafe JS session: Redis-backed sessions and double-submit CSRF protection",
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --dts --format esm --sourcemap"
	},
	"dependencies": {
		"@alxarafe/core": "workspace:*",
		"connect-redis": "^10.0.0",
		"express": "5.2.1",
		"express-session": "^1.19.0",
		"http-status-codes": "2.3.0",
		"redis": "^6.2.1"
	},
	"devDependencies": {
		"@types/express": "5.0.3",
		"@types/express-session": "^1.19.0",
		"@types/node": "^22.0.0",
		"tsup": "^8.5.0"
	}
}
