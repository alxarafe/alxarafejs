{
	"name": "@alxarafe/email",
	"version": "0.1.0",
	"description": "Alxarafe JS email: SMTP transport with a file transport fallback for development",
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --dts --format esm --sourcemap"
	},
	"dependencies": {
		"@alxarafe/core": "workspace:*",
		"nodemailer": "^10.0.1"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/nodemailer": "^8.0.1",
		"tsup": "^8.5.0"
	}
}
