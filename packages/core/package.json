{
	"name": "@alxarafe/core",
	"version": "0.1.0",
	"description": "Alxarafe JS core: shared infrastructure (env, logger, HTTP, tokens, validation)",
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup src/index.ts --dts --format esm --sourcemap"
	},
	"dependencies": {
		"dotenv": "17.3.1",
		"express": "5.2.1",
		"express-rate-limit": "8.3.1",
		"http-status-codes": "2.3.0",
		"pino": "9.14.0",
		"pino-http": "10.5.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@types/express": "5.0.3",
		"@types/node": "^22.0.0",
		"pino-pretty": "13.1.3",
		"tsup": "^8.5.0"
	}
}
